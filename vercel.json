{
  "functions": {
    "api/devagents.js": {
      "maxDuration": 30
    },
    "api/projects/[kind].js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/repos",
      "destination": "/api/projects/repos"
    },
    {
      "source": "/api/friendliness",
      "destination": "/api/projects/friendliness"
    },
    {
      "source": "/api/badge",
      "destination": "/api/projects/badge"
    },
    {
      "source": "/api/label-health",
      "destination": "/api/projects/label-health"
    },
    {
      "source": "/auth/:action",
      "destination": "/api/auth/:action"
    },
    {
      "source": "/help/:owner/:repo/:issue",
      "destination": "/index.html"
    },
    {
      "source": "/u/:login",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/first-contribution",
      "destination": "/first-contribution/index.html"
    },
    {
      "source": "/for-maintainers",
      "destination": "/for-maintainers/index.html"
    },
    {
      "source": "/good-first-issues/:language",
      "destination": "/good-first-issues/:language/index.html"
    }
  ]
}
