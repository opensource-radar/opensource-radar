{
  "functions": {
    "api/devagents.js": {
      "maxDuration": 30
    },
    "api/friendliness.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/auth/:action",
      "destination": "/api/auth/:action"
    },
    {
      "source": "/help/:owner/:repo/:issue",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/first-contribution",
      "destination": "/first-contribution/index.html"
    },
    {
      "source": "/good-first-issues/:language",
      "destination": "/good-first-issues/:language/index.html"
    }
  ]
}
