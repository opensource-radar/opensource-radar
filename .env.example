# GitHub sign-in settings.
#
# Local testing: copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real values or share them.
# On Vercel: add the same three names under Project > Settings >
# Environment Variables (with the production OAuth app's values).

# From your GitHub OAuth App (Settings > Developer settings > OAuth Apps).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random string of at least 32 characters, used to encrypt the session cookie.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Optional: sync saved issues across devices. Vercel fills these in when you
# connect an Upstash Redis database from the project's Storage tab.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: the in-site "Report a problem" form. A fine-grained GitHub token
# limited to this repository with "Issues: Read and write" permission.
REPORT_GITHUB_TOKEN=
# REPORT_REPO=opensource-radar/opensource-radar

# Optional: project details (stars, activity) on issue cards for visitors who
# aren't signed in. A fine-grained GitHub token with "Public repositories
# (read-only)" access and no other permissions. Signed-in users don't need it.
GITHUB_READ_TOKEN=

# Optional: DevAgents, the in-site helper for working on an issue. It stays off
# unless this is exactly "true".
DEVAGENTS_ENABLED=
# Optional: only these GitHub logins see it (comma-separated). Empty means everyone.
DEVAGENTS_ALLOWED_LOGINS=
